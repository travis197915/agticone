# Copy to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env

# ── LLM routing ───────────────────────────────────────────────────────────────
#
# Mode A — UHG AI gateway via MODEL_REGISTRY_JSON (recommended for UHG deploy)
#   1. Copy uhc-llm/config/registries/uhg-gateway.example.json to a local file
#   2. Replace YOUR-GATEWAY-HOST with real api.uhg.com paths
#   3. Run: uhc-llm-export-registry /path/to/your-registry.json >> .env
#
# Mode B — Direct provider API keys (local dev)
#   LLM_BACKEND=api_key
#   OPENAI_API_KEY=sk-...
#   ANTHROPIC_API_KEY=sk-ant-...

LLM_BACKEND=registry
LLM_MODEL=gpt-5-mini

# Full gateway model list as one JSON string (Option A). Replace YOUR-GATEWAY-HOST
# with real endpoints, or regenerate with uhc-llm-export-registry.
MODEL_REGISTRY_JSON='{"gpt-5-mini":{"kind":"azure_openai","endpoint":"https://YOUR-GATEWAY-HOST/api/cloud/api-management/ai-gateway-reasoning/1.0","deployment":"gpt-5-mini_2025-08-07","api_version":"2025-01-01-preview"},"llama":{"kind":"openai_compat","endpoint":"https://YOUR-GATEWAY-HOST/api/cloud/api-management/ai-gateway/1.0","deployment":"llama-3-3_70b-instruct"},"opus":{"kind":"bedrock_claude","endpoint":"https://YOUR-GATEWAY-HOST/api/cloud/api-management/ai-gateway/1.0","deployment":"us.anthropic.claude-opus-4-6-v1"}}'

# UHG gateway auth (required when LLM_BACKEND=registry)
PROJECT_ID=
AI_GATEWAY_API_KEY=

# Optional — only if you want per-agent model overrides (registry mode)
# AGENT_MODEL_MAP=execution

# Direct API key mode (when LLM_BACKEND=api_key)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-match-claims-corebackend

# ── Postgres ──────────────────────────────────────────────────────────────────
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_HOST=
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_HOST=
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=sop_ingestion

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ── Pipeline ────────────────────────────────────────────────────────────────
MAX_DEPTH=4
MAX_DOCS=200
LLM_PROVIDER=anthropic
