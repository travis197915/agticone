# Copy to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env

# ── LLM routing ───────────────────────────────────────────────────────────────
#
# Mode A — UHG AI gateway via MODEL_REGISTRY_JSON (recommended for UHG deploy)
#   1. Copy uhc-llm/config/registries/uhg-gateway.example.json to a local file
#   2. Replace YOUR-GATEWAY-HOST with real api.uhg.com paths
#   3. Run: uhc-llm-export-registry /path/to/your-registry.json >> .env
#
# Mode A2 — Azure Key Vault (production; matches reference ask_llm.py)
#   1. cp .env.stg.example .env.stg  (KV connection creds only)
#   2. Store secrets in Key Vault with hyphen names: CLIENT-ID, AUTH-URL, SCOPE,
#      CLIENT-SECRET, PROJECT-ID, MODEL-REGISTRY-JSON, …
#   3. Django/Celery calls bootstrap_llm_secrets() at startup automatically
#
# Mode B — Direct provider API keys (local dev)
#   LLM_BACKEND=api_key
#   OPENAI_API_KEY=sk-...
#   ANTHROPIC_API_KEY=sk-ant-...

LLM_BACKEND=registry
LLM_MODEL=gpt-5-mini

# Full gateway model list as one JSON string (Option A). Replace YOUR-GATEWAY-HOST
# with real endpoints, or regenerate with uhc-llm-export-registry.
MODEL_REGISTRY_JSON='{"gpt-5-mini":{"kind":"azure_openai","endpoint":"https://YOUR-GATEWAY-HOST/api/cloud/api-management/ai-gateway-reasoning/1.0","deployment":"gpt-5-mini_2025-08-07","api_version":"2025-01-01-preview"},"llama":{"kind":"openai_compat","endpoint":"https://YOUR-GATEWAY-HOST/api/cloud/api-management/ai-gateway/1.0","deployment":"llama-3-3_70b-instruct"},"opus":{"kind":"bedrock_claude","endpoint":"https://YOUR-GATEWAY-HOST/api/cloud/api-management/ai-gateway/1.0","deployment":"us.anthropic.claude-opus-4-6-v1"}}'

# UHG gateway auth (required when LLM_BACKEND=registry)
#
# Option 1 — OAuth client credentials (recommended for UHG / Azure AD):
# AUTH_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
# SCOPE=https://api.uhg.com/.default
# CLIENT_ID=
# CLIENT_SECRET=
#
# Option 2 — APIM subscription key:
PROJECT_ID=
AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=            # optional fallback if AI_GATEWAY_API_KEY unset

# Optional — only if you want per-agent model overrides (registry mode)
# AGENT_MODEL_MAP=execution

# ── Azure Key Vault (optional — production secret bootstrap) ─────────────────
# Connection creds only; LLM/OAuth secrets live IN the vault as hyphenated names.
# AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
#
# Default: fetch only focused LLM/gateway secrets (fast startup).
# KEYVAULT_LOAD_ALL_SECRETS=true
# KEYVAULT_LLM_SECRET_NAMES=AUTH-URL,CLIENT-ID,SCOPE,MODEL-REGISTRY-JSON

# Direct API key mode (when LLM_BACKEND=api_key)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-match-claims-corebackend

# ── Postgres ──────────────────────────────────────────────────────────────────
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# ── Redis ───────────────────────────────────────────────────────────────────
# PROD ONLY (APP_ENV=prod): Redis connects over TLS (rediss://) for the managed
# Azure endpoint. REDIS_SSL toggles it (default on in prod); non-prod always
# uses a plain connection. REDIS_SSL_CHECK_HOSTNAME defaults false (Azure
# private link cert won't pass hostname verification).
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=
# REDIS_SSL=true
# REDIS_SSL_CHECK_HOSTNAME=false

# ── Environment ─────────────────────────────────────────────────────────────
# Set APP_ENV=prod (or production) in the prod environment. ONLY then are the
# prod connection overrides (MONGO_URI / NEO4J_URI / NEO4J_SCHEME / Redis TLS)
# used; local dev / CI always use the plain host:port builds below.
APP_ENV=

# ── Neo4j ───────────────────────────────────────────────────────────────────
# PROD ONLY (APP_ENV=prod): NEO4J_URI wins if set (full URI); else NEO4J_SCHEME
# is combined with NEO4J_HOST/PORT. Prod DEFAULT scheme is bolt+ssc — a DIRECT
# connection with self-signed-cert TLS. Do NOT use a routing scheme (neo4j /
# neo4j+ssc) for a single-instance server or the driver fails with "Unable to
# retrieve routing information". Use neo4j+ssc only for a cluster / Aura.
# Non-prod always uses plain neo4j://.
# NEO4J_URI=bolt+ssc://neo4j.example.com:7687
# NEO4J_SCHEME=bolt+ssc
NEO4J_HOST=
NEO4J_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ── MongoDB ─────────────────────────────────────────────────────────────────
# PROD ONLY (APP_ENV=prod): MONGO_URI is used — the full connection string,
# typically Atlas. Non-prod ignores MONGO_URI and uses the host/port below.
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_HOST=
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DATABASE=sop_ingestion

# ── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# ── Pipeline ────────────────────────────────────────────────────────────────
MAX_DEPTH=4
MAX_DOCS=200
LLM_PROVIDER=anthropic

# ── External claims MCP / mock server (tool routing) ─────────────────────────
# When MCP_SERVER_BASE_URL is set, the execution engine uses these values instead
# of the mcp_server_config DB table (recommended for production — keeps secrets
# in env/Key Vault, not Postgres). Per-tool paths still live on Tool.metadata.mcp_path.
#
# MCP_SERVER_BASE_URL=https://claims-mock-mcp-server.example.com
# MCP_SERVER_API_KEY=
# MCP_SERVER_AUTH_HEADER=x-api-key
# MCP_SERVER_HTTP_METHOD=POST
# MCP_SERVER_CLAIM_ARG=claim_number
# MCP_SERVER_TIMEOUT_SECONDS=30
# Probe MCP once per claim before any tool call; set false to skip (local dev).
# MCP_HEALTH_CHECK_ENABLED=true
# RULE_ENGINE_TOOL_INVOKE_TIMEOUT_SECONDS=100  # parallel prefetch cap; 0=disable
# RULE_ENGINE_TOOL_SLOW_MS=25000             # warn when in-process tools exceed this
# AGENT_TOOLS_HTTP_TIMEOUT=30                # in-process HTTP tool timeout
